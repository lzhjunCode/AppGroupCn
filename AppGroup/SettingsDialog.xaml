<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="AppGroup.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               CornerRadius="8"
               MinWidth="500"
              >

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0,0,0,0</Thickness>

        <!-- Custom styles for better consistency -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" VerticalAlignment="Center" Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}" CornerRadius="5" HorizontalAlignment="Stretch">
        <Grid Padding="10,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditTitle" FontSize="20" Margin="10" VerticalAlignment="Center" FontWeight="SemiBold">
                设置
            </TextBlock>
            <Button Click="CloseDialog" Grid.Column="1" Height="35" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xe711;" FontSize="15"/>
            </Button>
        </Grid>

        <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Margin="20,0,20,20">

                <!-- Application Section -->

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="开机自启动"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                            <TextBlock Text="Windows 启动时自动运行本应用"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     Margin="0,2,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="StartupToggle"
                                    Grid.Column="1"
                                    IsOn="True"
                                    OnContent=""
                                    OffContent=""
                                    VerticalAlignment="Center"
                                   />
                    </Grid>
                </Border>
                <!-- System Tray Section -->

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="显示系统托盘图标"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"/>
                            <TextBlock Text="在系统托盘显示应用图标"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="SystemTrayToggle" 
                      Grid.Column="1"
                      IsOn="True"
                      OnContent=""
                      OffContent=""
                      VerticalAlignment="Center"
                     />
                    </Grid>
                </Border>

                <TextBlock VerticalAlignment="Center" Text="动画" FontWeight="SemiBold" Margin="5,30,5,5"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="窗口 "
                     FontWeight="SemiBold"
                     FontSize="14"
                     TextWrapping="Wrap"/>
                            <TextBlock Text="打开和关闭窗口时显示动画"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Margin="0,2,0,0"
                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="WindowSlideAnimationToggle"
                    Grid.Column="1"
                    IsOn="True"
                    OnContent=""
                    OffContent=""
                    VerticalAlignment="Center"/>
                    </Grid>
                </Border>


                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="内容 "
       FontWeight="SemiBold"
       FontSize="14"
       TextWrapping="Wrap"/>
                            <TextBlock Text="分组内项目显示动画"
       FontSize="12"
       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
       Margin="0,2,0,0"
       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="ContentSlideAnimationToggle"
      Grid.Column="1"
      IsOn="True"
      OnContent=""
      OffContent=""
      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock VerticalAlignment="Center" Text="外观" FontWeight="SemiBold" Margin="5,10,5,5"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="应用主题"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"/>
                            <TextBlock Text="选择应用使用的主题"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="ThemeComboBox"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色" Tag="Dark"/>
                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="弹出窗口主题"
                       FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="选择弹出窗口的主题"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="PopupThemeComboBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="160">
                            <ComboBoxItem Content="浅色"        Tag="Light"/>
                            <ComboBoxItem Content="深色"         Tag="Dark"/>
                            <ComboBoxItem Content="应用模式 "   Tag="AppMode"/>
                            <ComboBoxItem Content="Windows 模式 " Tag="WindowsMode"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border x:Name="AccentBackgroundCard"  Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="强调色背景"
                   FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AccentBackgroundDescription"
                   Text="使用 Windows 强调色作为弹出窗口背景"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch x:Name="AccentBackgroundToggle"
                  Grid.Column="1"
                  IsOn="True"
                  OnContent="" OffContent=""
                  VerticalAlignment="Center"/>
                        </Grid>

                        <InfoBar x:Name="AccentBackgroundInfoBar"
         IsOpen="False"
         IsClosable="False"
         Severity="Warning"
         Margin="0,8,0,0">
                            <InfoBar.Content>
                                <TextBlock 
            Text=" 仅当弹出窗口主题为 Windows 模式时可用"
         
                                    TextAlignment="Left"
            FontSize="12"
        />
                            </InfoBar.Content>
                        </InfoBar>
                    </StackPanel>
                </Border>
                <TextBlock VerticalAlignment="Center" Text="其他" FontWeight="SemiBold" Margin="5,30,5,5"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="启用&quot;全部启动&quot;"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                            <TextBlock Text="在右键菜单中显示&quot;全部启动&quot;选项"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Margin="0,2,0,0"
                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="LaunchAllToggle"
                    Grid.Column="1"
                    IsOn="False"
                    OnContent=""
                    OffContent=""
                    VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="灰度图标"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                            <TextBlock Text="分组显示时以灰度显示图标"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     Margin="0,2,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="GrayscaleIconToggle"
                                    Grid.Column="1"
                                    IsOn="False"
                                    VerticalAlignment="Center"
                                    OnContent=""
                                    OffContent=""
                                    Toggled="GrayScaleToggle_Toggled"
                                   />
                    </Grid>
                </Border>



                <TextBlock VerticalAlignment="Center" Text="关于" FontWeight="SemiBold" Margin="5,30,5,5"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AppGroup"
                                 FontWeight="SemiBold"
                                 FontSize="14"/>
                        <TextBlock x:Name="VersionText"
                                 Text="版本"
                                 FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="启动时检查更新"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                            <TextBlock Text="应用启动时自动检查新版本"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     Margin="0,2,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="UpdateCheckToggle"
                                    Grid.Column="1"
                                    IsOn="True"
                                    VerticalAlignment="Center"
                                    OnContent=""
                                    OffContent=""
                                   />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="检查更新"
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         TextWrapping="Wrap"/>
                                <TextBlock x:Name="UpdateStatusText"
                                         Text="点击检查新版本"
                                         FontSize="12"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         Margin="0,2,0,0"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="CheckUpdateButton"
                                    Grid.Column="1"
                                    Content="立即检查"
                                    Click="CheckUpdateButton_Click"
                                    VerticalAlignment="Center"
                                    Padding="16,8"/>
                        </Grid>

                        <InfoBar x:Name="UpdateInfoBar"
                                 IsOpen="False"
                                 Severity="Success"
                                 Title="有可用更新"
                                 Margin="0,12,0,0"
                                 IsClosable="True">
                            <InfoBar.ActionButton>
                                <Button Content="下载" Click="DownloadUpdate_Click"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>